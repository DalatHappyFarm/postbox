{
  "name": "@dalathappyfarm/postbox-react-native",
  "version": "0.3.0",
  "description": "In-app feedback with an automatic screenshot and attached photos for React Native and Expo apps. Sends to a Postbox server.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "expo-application": ">=5",
    "expo-device": ">=5",
    "expo-file-system": ">=18",
    "expo-image-manipulator": ">=18",
    "expo-image-picker": ">=18",
    "expo-secure-store": ">=12",
    "expo-sensors": ">=12",
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-view-shot": ">=3.8"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "expo-application": "^58.1.1",
    "expo-device": "^58.0.5",
    "expo-file-system": "^58.0.9",
    "expo-image-manipulator": "^58.0.14",
    "expo-image-picker": "^58.0.10",
    "expo-secure-store": "^58.0.2",
    "expo-sensors": "^58.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-view-shot": "^6.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DalatHappyFarm/postbox.git",
    "directory": "packages/react-native"
  }
}
